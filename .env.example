# Ragic ERP Backup System v2 - 環境變數範例
# 複製此檔案為 .env 並填入實際值

# Ragic API 設定
RAGIC_API_KEY=your_base64_encoded_api_key
RAGIC_ACCOUNT=grefun
RAGIC_SERVER=ap6.ragic.com
RAGIC_PAGE_SIZE=1000
RAGIC_MAX_PAGES=50
RAGIC_TIMEOUT=180
RAGIC_MAX_RETRIES=5

# GCP 設定
GCP_PROJECT_ID=b25h01-ragic
BIGQUERY_DATASET=erp_backup
BIGQUERY_LOCATION=asia-east1

# 郵件設定 (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=gcp.ops.notifications@gmail.com
SMTP_FROM_PASSWORD=your_app_password
NOTIFICATION_EMAIL=gamepig1976@gmail.com

# LINE Messaging API 設定
# 1. 建立 LINE Official Account (https://developers.line.biz/)
# 2. 建立 Messaging API Channel
# 3. 取得 Channel Access Token（長期有效）
# 4. 取得目標 User ID 或 Group ID
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_MESSAGING_USER_ID=your_user_or_group_id

# (可選) Telegram Bot 設定 - 可作為備用通知管道
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# =============================================================================
# 資料清洗系統 v2 設定
# =============================================================================

# OpenRouter AI 設定
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=google/gemini-pro
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_RETRIES=3

# AI 信心度閾值
AI_CONFIDENCE_THRESHOLD=0.90
AI_AUTO_APPLY_THRESHOLD=0.95

# 清洗引擎設定
CLEANING_BATCH_SIZE=100
CLEANING_MAX_RECORDS=10000
CLEANING_TIMEOUT_MINUTES=15

# 規則配置路徑
RULES_DIR=rules
RULES_SCHEMA=rules/schema.yaml

# 清洗資料表設定
CLEANING_RESULTS_TABLE=cleaning_results
VIOLATIONS_TABLE=violations
CLEANING_HISTORY_TABLE=cleaning_history
CLEANING_BATCHES_TABLE=cleaning_batches

# 通知設定
ENABLE_NOTIFICATIONS=true
DATA_CORRECTION_APP_URL=https://correction.ragic-edp.example.com
ESCALATION_DAYS=3

# 日誌設定
LOG_LEVEL=INFO
LOG_FORMAT=json
