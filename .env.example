# Ragic ERP Backup System v2 - 環境變數範例
# 複製此檔案為 .env 並填入實際值

# Ragic API 設定
RAGIC_API_KEY=your_base64_encoded_api_key
RAGIC_ACCOUNT=grefun
RAGIC_SERVER=ap6.ragic.com
RAGIC_PAGE_SIZE=1000
RAGIC_MAX_PAGES=50
RAGIC_TIMEOUT=180
RAGIC_MAX_RETRIES=5

# GCP 設定
GCP_PROJECT_ID=b25h01-ragic
BIGQUERY_DATASET=erp_backup
BIGQUERY_LOCATION=asia-east1

# 郵件設定 (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=gcp.ops.notifications@gmail.com
SMTP_FROM_PASSWORD=your_app_password
NOTIFICATION_EMAIL=gamepig1976@gmail.com
