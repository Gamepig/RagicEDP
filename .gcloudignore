# .gcloudignore
# Cloud Functions 部署時忽略的檔案
# 只上傳必要的程式檔案

# ===================
# Git
# ===================
.git/
.gitignore

# ===================
# Python 環境
# ===================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/

# ===================
# 環境變數（使用 Secret Manager）
# ===================
.env
.env.*

# ===================
# 本地專用目錄（開頭 _）
# ===================
_archived/
_docs/
_local/

# ===================
# 開發工具配置
# ===================
.claude/
.code-summary/
.serena/
.ums/
.vscode/
.idea/
.mcp.json
pyrightconfig.json

# ===================
# 文件（不需要部署）
# ===================
*.md
LICENSE

# ===================
# 腳本（本地使用）
# ===================
scripts/

# 注意：rules/ 需要部署，不要排除

# ===================
# 其他專案（獨立部署）
# ===================
data-correction-app/

# ===================
# 資料與日誌
# ===================
*.json
*.csv
*.log
*.sqlite
*.db

# ===================
# 系統檔案
# ===================
.DS_Store
Thumbs.db
*.swp
*.swo

# ===================
# 測試
# ===================
tests/
test_*.py
*_test.py
conftest.py
pytest.ini
.pytest_cache/

# ===================
# 套件管理（使用 requirements.txt）
# ===================
uv.lock
poetry.lock
Pipfile
Pipfile.lock
