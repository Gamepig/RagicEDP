rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /allowlist_users/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /dashboard_config/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /chat_sessions/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    // AI Expert Phase 2
    match /ai_sessions/{sessionId} {
      // Session metadata readable by all authenticated users (org-wide search)
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Messages are owner-only
      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/ai_sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    match /ai_knowledge/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /ai_usage_stats/{date} {
      allow read: if isSignedIn();
      // write: server-side only (admin SDK)
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
